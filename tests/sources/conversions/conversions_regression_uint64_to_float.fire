import @firescript/std.io.println;

// Regression: `uint64 as float64` / `as float32` failed to assemble
// ("unsupported mnemonic: js" / "shr") because the self-hosted assembler
// lacked the `js` jump and `shr r64, 1` used by the unsigned 64-bit -> float
// conversion sequence. Values at or above 2^63 are halved with the low bit
// OR-ed back in (the sticky bit); the cases below are chosen so that
// round-to-nearest-even, truncation, and a lost sticky bit all give
// different answers. Expected values are computed with Python's exact
// integer arithmetic (float64: float(v); float32: manual round-half-even to
// 24 bits).
zero: uint64 = 0u64;
println(zero as float64);

small: uint64 = 42u64;
println(small as float64);

f32small: uint64 = 1000u64;
println(f32small as float32);

v0: uint64 = 9223372036854775808u64;
println(v0 as float64);
println(v0 as float32);

v1: uint64 = 9223372036854775809u64;
println(v1 as float64);
println(v1 as float32);

v2: uint64 = 9223372036854776832u64;
println(v2 as float64);
println(v2 as float32);

v3: uint64 = 9223372036854776833u64;
println(v3 as float64);
println(v3 as float32);

v4: uint64 = 9223372036854778880u64;
println(v4 as float64);
println(v4 as float32);

v5: uint64 = 9223372036854778881u64;
println(v5 as float64);
println(v5 as float32);

v6: uint64 = 18446744073709551615u64;
println(v6 as float64);
println(v6 as float32);

v7: uint64 = 18446744073709550592u64;
println(v7 as float64);
println(v7 as float32);

v8: uint64 = 9223372586610589696u64;
println(v8 as float64);
println(v8 as float32);

v9: uint64 = 9223372586610589697u64;
println(v9 as float64);
println(v9 as float32);

v10: uint64 = 9223373686122217472u64;
println(v10 as float64);
println(v10 as float32);

v11: uint64 = 12345678901234567891u64;
println(v11 as float64);
println(v11 as float32);

/* EXPECT
