42.000000
1000.000000
9223372036854775808.000000
9223372036854775808.000000
9223372036854775808.000000
9223372036854775808.000000
9223372036854775808.000000
9223372036854775808.000000
9223372036854777856.000000
9223372036854775808.000000
9223372036854779904.000000
9223372036854775808.000000
9223372036854779904.000000
9223372036854775808.000000
18446744073709551616.000000
18446744073709551616.000000
18446744073709551616.000000
18446744073709551616.000000
9223372586610589696.000000
9223372036854775808.000000
9223372586610589696.000000
9223373136366403584.000000
9223373686122217472.000000
9223374235878031360.000000
12345678901234567168.000000
12345679395506094080.000000
*/
