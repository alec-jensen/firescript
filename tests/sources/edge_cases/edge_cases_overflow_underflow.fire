import @firescript/std.io.println;
import @firescript/std.math.wrapping.wrapping_add;
import @firescript/std.math.wrapping.wrapping_sub;

// Explicit wrapping arithmetic (plain + - * trap on overflow; see the
// invalid-overflow tests under tests/sources/runtime_traps/)
overflow_test: int8 = 127i8;
println(overflow_test);
println(wrapping_add(overflow_test, 1i8));

uoverflow: uint8 = 255u8;
println(uoverflow);
println(wrapping_add(uoverflow, 1u8));

// Underflow
underflow: int8 = -128i8;
println(underflow);
println(wrapping_sub(underflow, 1i8));

/* EXPECT
127
-128
255
0
-128
127
*/
