//@ exit-code: 101
//@ stderr-contains: firescript runtime error: IntegerOverflow: multiplication on int32
// int32: MAX * 2 traps.
import @firescript/std.io.println;

println("before");
a: int32 = 2147483647i32;
b: int32 = 2i32;
c: int32 = a * b;
println(c);
println("not reached");

/* EXPECT
before
*/
