//@ exit-code: 101
//@ stderr-contains: firescript runtime error: IntegerOverflow: addition on uint32
// uint32: MAX + 1 traps.
import @firescript/std.io.println;

println("before");
a: uint32 = 4294967295u32;
b: uint32 = 1u32;
c: uint32 = a + b;
println(c);
println("not reached");

/* EXPECT
before
*/
