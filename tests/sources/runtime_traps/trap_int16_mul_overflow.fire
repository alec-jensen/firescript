//@ exit-code: 101
//@ stderr-contains: firescript runtime error: IntegerOverflow: multiplication on int16
// int16: MAX * 2 traps.
import @firescript/std.io.println;

println("before");
a: int16 = 32767i16;
b: int16 = 2i16;
c: int16 = a * b;
println(c);
println("not reached");

/* EXPECT
before
*/
