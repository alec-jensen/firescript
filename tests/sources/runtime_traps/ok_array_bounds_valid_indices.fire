// Every valid index must NOT trap: first and last element, negative indices
// down to -length, reads and writes, constant and runtime indices, array
// parameters (hidden length), several index types, and ArrayList within size.
import @firescript/std.io.println;
import @firescript/std.collections.ArrayList;

fn last(&a: int32[]) -> int32 {
    return a[-1];
}

fn first(&a: int32[]) -> int32 {
    return a[0];
}

arr: int32[5] = [1, 2, 3, 4, 5];
println(arr[0]);
println(arr[4]);
println(arr[-1]);
println(arr[-5]);
i: int32 = 4;
println(arr[i]);
j: int32 = -5;
println(arr[j]);
k: int64 = 2i64;
println(arr[k]);
m: uint8 = 3u8;
println(arr[m]);
arr[0] = 10;
arr[-1] = 50;
arr[i - 1] = 40;
println(arr[0]);
println(arr[4]);
println(arr[3]);
println(last(arr));
println(first(arr));

l: ArrayList<int32> = ArrayList<int32>();
l.add(7);
l.add(8);
l.add(9);
println(l.get(0));
println(l.get(2));
l.set(1, 80);
println(l.get(1));
println(l.removeLast());
println(l.size());

/* EXPECT
