//@ exit-code: 101
//@ stderr-contains: firescript runtime error: IndexOutOfBounds: index 7, length 5
// arr[7] = x on a length-5 array traps.
import @firescript/std.io.println;

println("before");
arr: int32[5] = [1, 2, 3, 4, 5];
i: int32 = 7;
arr[i] = 9;
println(arr[0]);
println("not reached");

