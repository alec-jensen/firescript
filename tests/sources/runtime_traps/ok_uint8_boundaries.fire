// uint8: operations that land exactly on MIN/MAX (or return to it) must NOT trap.
import @firescript/std.io.println;

max: uint8 = 255u8;
min: uint8 = 0u8;
one: uint8 = 1u8;
two: uint8 = 2u8;
zero: uint8 = 0u8;
println(max);
println(min);
println(max - one + one);
println(min + one - one);
println(max * one);
println(max / one);
println(min / one);
println(min % two);
println(max % max);
println((max - one) / two * two);
println(zero - zero);

/* EXPECT
255
0
255
0
255
255
0
0
0
254
0
*/
