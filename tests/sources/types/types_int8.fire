import @firescript/std.io.println;
import @firescript/std.math.wrapping.wrapping_add;
import @firescript/std.math.wrapping.wrapping_sub;

i8_min: int8 = -128i8;
i8_max: int8 = 127i8;
i8_zero: int8 = 0i8;
println(i8_min);
println(i8_max);
println(i8_zero);
println(wrapping_add(i8_max, 1i8));  // explicit wrapping overflow (plain + would trap)
println(wrapping_sub(i8_min, 1i8));  // explicit wrapping underflow

/* EXPECT
-128
127
0
-128
127
*/
