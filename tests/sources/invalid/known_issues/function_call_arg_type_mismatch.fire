// KNOWN ISSUE (not yet fixed): passing an argument of the wrong type to a free function is reported as an internal FIR verifier error (FIRV-T5), not a semantic error.
// The type checker (firescript/parser/type_system.py) has no check for this,
// so it is either silently accepted or only caught by a later IR verifier
// pass and reported as "internal compiler error ... this is a compiler bug"
// instead of a user-facing diagnostic. This file fails until a real
// diagnostic with the annotated code is produced; do not delete or loosen it.

import @firescript/std.io.println;

fn identity(a: int32) -> int32 {
    return a;
}

println(identity("not a number"));  //~ ERROR FS-SEM-0010
