// Generic type errors

fn identity<T>(value: T) -> T {
    return value;
}

// Explicit type argument that disagrees with the call argument
fn wrong_explicit_type_argument() -> void {
    x: string = identity<string>(42);  //~ ERROR FS-SEM-0010 @34
}

fn wrong_explicit_type_argument_int() -> void {
    y: int32 = identity<int32>("text");  //~ ERROR FS-SEM-0010 @32
}

// Constraint violation
constraint Numeric = int32 | float32;

fn add<T: Numeric>(a: T, b: T) -> T {
    return a + b;
}

fn violate_constraint() -> void {
    result: string = add<string>("hello", "world");  //~ ERROR FS-SEM-0010 @22
}

// Too many type parameters
fn too_many_type_params() -> void {
    x: int32 = identity<int32, string>(5);  //~ ERROR FS-SEM-0010 @16
}

// Generic class field type error
class Box<T> {
    value: T;

    fn Box(&mut this, value: T) {
        this.value = value;
    }
}

fn generic_class_field_type_error() -> void {
    box: Box<int32> = Box<int32>(1);
    box.value = "string";  // value is int32, not string  //~ ERROR FS-SEM-0002 @15
}

// A generic class takes exactly as many type arguments as it declares
fn generic_class_type_argument_count() -> void {
    pair: Box<int32, string> = Box<int32, string>(1);  //~ ERROR FS-SEM-0010 @11
}
