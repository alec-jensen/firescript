// Invalid control flow tests: misplaced break/continue and non-bool
// conditions.
import @firescript/std.io.println;

fn breakOutsideLoop() -> void {
    break; // should error (not inside loop)  //~ ERROR FS-SEM-0010 @5
}

fn continueOutsideLoop() -> void {
    continue; // should error  //~ ERROR FS-SEM-0010 @5
}

fn ifStringCondition() -> void {
    if ("hello") { println(1); }  //~ ERROR FS-SEM-0010 @9
}

fn whileIntCondition() -> void {
    while (1) { println(1); }  //~ ERROR FS-SEM-0010 @12
}
