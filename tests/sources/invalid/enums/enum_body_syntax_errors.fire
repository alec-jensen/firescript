// Malformed enum bodies not covered by enum_def_errors.fire.

// Missing '{' to start enum body.
enum NoBrace
topLevel: int32 = 1;  //~ ERROR FS-PARSE-0010 @1

// Missing '}' to close the enum body (runs off the end of the file); a
// trailing comment after the last variant is not an error of its own.
enum Unclosed {
    A  //~ ERROR FS-PARSE-0010 @6
