import @firescript/std.io.println;

// A function's own parameters and locals are scoped to the function (access to
// top-level variables from functions is covered by
// scoping_regression_function_global_variables).
fn testFunction(param: int32) -> int32 {
    local: int32 = 10;
    println(param);
    println(local);
    return local + param;
}

println(testFunction(5));

/* EXPECT
5
10
15
*/
