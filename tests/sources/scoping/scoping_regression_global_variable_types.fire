// Regression: module-level variables of every storage shape -- a copyable
// class (a by-value struct), float128 (16 bytes), float32, char and uint64
// -- are read and written from a function through static storage.
import @firescript/std.io.println;

copyable class Point {
    x: int32;
    y: int32;
    fn Point(&mut this, x: int32, y: int32) { this.x = x; this.y = y; }
}

origin: Point = Point(1, 2);
big: float128 = 1.25f128;
small: float32 = 0.5f32;
ch: char = 'a';
u: uint64 = 18446744073709551615u64;

fn move_origin() -> void {
    origin = Point(origin.x + 10, origin.y + 20);
    big = big + 1.0f128;
    small = small * 3.0f32;
    ch = 'b';
    u = u - 1u64;
}

move_origin();
println(origin.x);
println(origin.y);
println(big);
println(small);
println(ch);
println(u);

/* EXPECT
11
22
2.250000
1.500000
b
18446744073709551614
*/
