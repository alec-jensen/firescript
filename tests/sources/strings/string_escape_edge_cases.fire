//@ snapshot: fir, flir
import @firescript/std.io.println;

// An escaped single-quote inside a (double-quoted) string literal is a
// valid, redundant escape: codegen/x86_64/flir_to_asm.py's _escape_asciz()
// passes `\'` through as a literal `'`. (Unknown escapes such as `\q` are
// rejected at compile time -- see invalid/strings/unknown_escape_string.fire.)
s1: string = "it\'s here";
println(s1);

/* EXPECT
it's here
*/
