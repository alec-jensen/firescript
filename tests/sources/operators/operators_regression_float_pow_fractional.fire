import @firescript/std.io.println;

// Regression (B02): float `**` truncated the exponent to an integer, so
// `2.0 ** 0.5` was 1.0. `**` now follows IEEE 754 pow semantics. Exponent
// and base are passed through variables so nothing is constant-folded.
// Expected values come from Python's math.pow (libm); `== lit` lines check
// the bit-exact result and the `tol` lines allow 4 ulp where the runtime
// is accurate to about 1 ulp rather than correctly rounded.
zero: float64 = 0.0;
inf: float64 = 1.0 / zero;
nan: float64 = zero / zero;
nzero: float64 = -zero;

println("-- fractional exponents --");

println(2.0 ** 0.5);
println(9.0 ** 0.5);
println(10.0 ** 2.5);
println(0.25 ** 0.5);
println(2.0 ** -0.5);
println(27.0 ** 0.3333333333333333);
println(1.5 ** 10.5);
println(7.0 ** -0.3);
println(100.0 ** 1.5);
println(0.5 ** 0.25);

// Bit-exact checks (result must equal the correctly rounded value).
println((9.0 ** 0.5) == 3.0);
println((1.5 ** 10.5) == 70.62496085039253);
println((7.0 ** -0.3) == 0.5577898253032461);
println((27.0 ** 0.3333333333333333) == 3.0);
println((100.0 ** 1.5) == 1000.0);
println((1e-300 ** 0.5) == 1e-150);
println((1e+300 ** 0.5) == 1e+150);
println((2.0 ** -1074.0) == 5e-324);
println((2.0 ** 1023.0) == 8.98846567431158e+307);
println((0.1 ** 3.0) == 0.0010000000000000002);
println((2.0 ** 100.0) == 1.2676506002282294e+30);
println((3.0 ** -4.0) == 0.012345679012345678);
println((1.0000001 ** 1000000000.0) == 2.6881038582144647e+43);
println((1.1 ** 50.0) == 117.39085287969579);
println((2.5 ** 2.0) == 6.25);
println((10.0 ** -2.0) == 0.01);

// Within 4 ulp.
d0: float64 = (2.0 ** 0.5) - 1.4142135623730951;
println(d0 <= 8.881784197001252e-16 && d0 >= -8.881784197001252e-16);
d1: float64 = (10.0 ** 2.5) - 316.22776601683796;
println(d1 <= 2.2737367544323206e-13 && d1 >= -2.2737367544323206e-13);
d2: float64 = (2.0 ** -0.5) - 0.7071067811865476;
println(d2 <= 4.440892098500626e-16 && d2 >= -4.440892098500626e-16);
d3: float64 = (0.5 ** 0.25) - 0.8408964152537145;
println(d3 <= 4.440892098500626e-16 && d3 >= -4.440892098500626e-16);

println("-- negative bases --");
println(-2.0 ** 3.0);
println(-2.0 ** 2.0);
println(-2.0 ** -3.0);
println(-8.0 ** 0.3333333333333333);
println(-0.5 ** 2.5);
println(-27.0 ** 3.0);
println(-1.0 ** 0.5);
println("-- zero, infinity, NaN special values --");
println(0.0 ** 0.0);
println(0.0 ** -1.0);
println(0.0 ** 0.5);
println(nzero ** 3.0);
println(nzero ** -3.0);
println(nzero ** 2.0);
println(inf ** 2.0);
println(inf ** -1.0);
println(-inf ** 3.0);
println(-inf ** -3.0);
println(-inf ** 2.0);
println(2.0 ** inf);
println(0.5 ** inf);
println(0.5 ** -inf);
println(2.0 ** -inf);
println(-1.0 ** inf);
println(nan ** 0.0);
println(1.0 ** nan);
println(nan ** 1.0);
println(2.0 ** nan);
println(2.0 ** 1024.0);
println(5.0 ** 0.0);
println(2.0 ** -1080.0);
println("-- integer exponents unchanged --");
println(2.0 ** 10.0);
println(2.0 ** 0.0);
println(3.0 ** 3.0);
println(2.0 ** -2.0);
println(5.0 ** 1.0);
println(-3.0 ** 3.0);
println(1.5 ** 2.0);

