// split(s, delim): splits on every occurrence of delim, including
// leading/trailing/adjacent empty fields. Returns ArrayList<string> -- drained
// with removeLast() below (LIFO order) rather than get()/enumerate(), which are
// only safe for a Copyable element type; string is Owned (see
// firescript/std/collections/init.fire's ArrayList<T> doc comment).

import @firescript/std.io.println;
import @firescript/std.text.split;
import @firescript/std.collections.ArrayList;

csv: string = "a,bb,ccc";
parts: ArrayList<string> = split(csv, ",");
println(parts.size());
println(parts.removeLast());
println(parts.removeLast());
println(parts.removeLast());

withEmpties: string = ",a,,b,";
parts2: ArrayList<string> = split(withEmpties, ",");
println(parts2.size());

noDelim: string = "hello world";
parts3: ArrayList<string> = split(noDelim, "::");
println(parts3.size());
println(parts3.removeLast());

multiChar: string = "a::b::c";
parts4: ArrayList<string> = split(multiChar, "::");
println(parts4.size());
println(parts4.removeLast());
println(parts4.removeLast());
println(parts4.removeLast());

/* EXPECT
3
ccc
bb
a
5
1
hello world
3
c
b
a
*/
