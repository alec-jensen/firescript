// StringBuilder: length() tracks appended characters (including empty
// appends), and build() drains the builder, leaving length() at 0 and
// allowing it to be reused.

import @firescript/std.io.println;
import @firescript/std.text.StringBuilder;

sb: StringBuilder = StringBuilder("ab");
println(sb.length());
sb.append("cde");
sb.append("");
println(sb.length());
println(sb.build());
println(sb.length());
println("[" + sb.build() + "]");
sb.append("xyz");
println(sb.length());
println(sb.build());

/* EXPECT
2
5
abcde
0
[]
3
xyz
*/
