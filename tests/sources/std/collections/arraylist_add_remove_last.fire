// ArrayList<T> basic add/removeLast/get/size, and growth beyond the initial capacity.

import @firescript/std.collections.ArrayList;
import @firescript/std.io.println;

v: ArrayList<int32> = ArrayList<int32>();
println(v.size());
v.add(10);
v.add(20);
v.add(30);
println(v.size());
println(v.get(0));
println(v.get(1));
println(v.get(2));

n: int32 = v.removeLast();
println(n);
println(v.size());

/* EXPECT
0
3
10
20
30
30
2
*/
