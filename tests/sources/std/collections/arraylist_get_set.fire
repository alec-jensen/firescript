// ArrayList<T>.set() overwriting an existing element by index.

import @firescript/std.collections.ArrayList;
import @firescript/std.io.println;

v: ArrayList<int32> = ArrayList<int32>();
v.add(1);
v.add(2);
v.add(3);
v.set(1, 99);
println(v.get(0));
println(v.get(1));
println(v.get(2));

/* EXPECT
1
99
3
*/
