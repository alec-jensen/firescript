import @firescript/std.io.println;
import @firescript/std.regex.is_match;

println(is_match("a{2,}", "a"));
println(is_match("a{2,}", "aa"));
println(is_match("a{2,}", "aaaaaaaa"));
println(is_match("a{0,}", ""));
println(is_match("a{0,}", "aaa"));
println(is_match("ba{1,}b", "bb"));
println(is_match("ba{1,}b", "baaab"));
println(is_match("[0-9]{2,}", "7"));
println(is_match("[0-9]{2,}", "70123"));

/* EXPECT
false
true
true
true
true
false
true
false
true
*/
