import @firescript/std.io.println;
import @firescript/std.collections.ArrayList;
import @firescript/std.regex.find_all;
import @firescript/std.regex.pattern.Match;

// find_all returns an ArrayList<Match>; removeLast() drains it back to front,
// so prepend each piece to get the matches in text order.
fn show(ms: ArrayList<Match>) -> string {
    out: string = "";
    while (ms.size() > 0) {
        m: Match = ms.removeLast();
        out = "[" + m.group(0) + "]" + out;
    }
    return out;
}

fn spans(ms: ArrayList<Match>) -> string {
    out: string = "";
    while (ms.size() > 0) {
        m: Match = ms.removeLast();
        out = (m.start() as string) + ":" + (m.end() as string) + " " + out;
    }
    return out;
}

println(show(find_all("\\d+", "a1b22c333")));
println(show(find_all("[a-c]", "abcabc")));
println(show(find_all("x", "abc")));
println(find_all("x", "abc").size());
println(find_all("\\d", "1 2 3").size());
println(spans(find_all("o+", "foo boo")));
// Matches never overlap
println(show(find_all("aa", "aaaaa")));
println(show(find_all("ab|bc", "abcabc")));
// Leftmost-first alternation, longest not required
println(show(find_all("a|ab", "abab")));

/* EXPECT
[1][22][333]
[a][b][c][a][b][c]

0
3
1:3 5:7
[aa][aa]
[ab][ab]
[a][a]
*/
