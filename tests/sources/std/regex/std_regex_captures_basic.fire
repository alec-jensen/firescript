import @firescript/std.io.println;
import @firescript/std.regex.find_first;
import @firescript/std.regex.pattern.Match;

m: Match = find_first("(\\d+)-(\\d+)", "tel 555-1234 ok", 0);
println(m.found());
println(m.start());
println(m.end());
println(m.group_count());
println(m.group(0));
println(m.group(1));
println(m.group(2));
println(m.group_start(1));
println(m.group_end(1));
println(m.group_start(2));
println(m.group_end(2));

/* EXPECT
true
4
12
2
555-1234
555
1234
4
7
8
12
*/
