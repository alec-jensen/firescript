import @firescript/std.io.println;
import @firescript/std.regex.find_first;
import @firescript/std.regex.pattern.Match;

// Empty text
m: Match = find_first("a*", "", 0);
println(m.found());
println(m.start());
println(m.end());
println(m.group(0) == "");

n: Match = find_first("a", "", 0);
println(n.found());

// Empty match at the search position, before any non-empty one
p: Match = find_first("a*", "baa", 0);
println(p.start());
println(p.end());
q: Match = find_first("a+", "baa", 0);
println(q.start());
println(q.end());

// Empty match at the very end of the text (the trailing $ forces it there)
r: Match = find_first("x*$", "ab", 0);
println(r.start());
println(r.end());

/* EXPECT
true
0
0
true
false
0
0
1
3
2
2
*/
