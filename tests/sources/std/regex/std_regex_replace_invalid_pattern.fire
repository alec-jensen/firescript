import @firescript/std.io.println;
import @firescript/std.regex.replace;

// An invalid pattern replaces nothing: the text comes back unchanged
println(replace("(a", "banana", "x"));
println(replace("a{2,1}", "banana", "x"));
println(replace("[a", "banana", "x"));
println(replace("*", "banana", "x"));

/* EXPECT
banana
banana
banana
banana
*/
