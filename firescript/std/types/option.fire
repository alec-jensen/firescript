class Option<T?> {
    value: T?;

    fn Option(&mut this, value: T?) {
        this.value = value;
    }

    fn isSome(&this) -> bool {
        return this.value != null;
    }

    fn isNone(&this) -> bool {
        return this.value == null;
    }
}

copyable class CopyableOption<T?> {
    value: T?;

    fn CopyableOption(&mut this, value: T?) {
        this.value = value;
    }

    fn isSome(&this) -> bool {
        return this.value != null;
    }

    fn isNone(&this) -> bool {
        return this.value == null;
    }
}