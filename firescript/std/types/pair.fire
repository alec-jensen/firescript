// Pair types: immutable, copyable product types.
// A Pair holds two values of potentially different types.

class Pair<T, U> {
    first: T;
    second: U;

    fn Pair(&mut this, first: T, second: U) {
        this.first = first;
        this.second = second;
    }
}

copyable class CopyablePair<T, U> {
    first: T;
    second: U;

    fn CopyablePair(&mut this, first: T, second: U) {
        this.first = first;
        this.second = second;
    }
}